# ===== Local Knowledge Base Platform 环境配置模板 =====
# 复制为 .env 并替换所有 change-this 值（deploy/check-environment.sh 会检查）
APP_ENV=production

APP_SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-secret

POSTGRES_DB=knowledge_base
POSTGRES_USER=kbuser
POSTGRES_PASSWORD=change-this-password

REDIS_PASSWORD=change-this-password

QDRANT_URL=http://qdrant:6333

EMBEDDING_URL=http://embedding:8001
RERANKER_URL=http://reranker:8002

LLM_BASE_URL=http://llm:8080/v1
LLM_API_KEY=change-this-secret
LLM_MODEL=qwen3-8b

API_DEFAULT_RATE_LIMIT=60

# 生产环境默认关闭 Swagger（/docs），调试时可临时设为 true
ENABLE_API_DOCS=false

# 对外网关端口（避开宿主机已占用端口）
GATEWAY_PORT=8080

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# 初始管理员（首次启动时创建，之后修改此处不生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
